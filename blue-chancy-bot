def add_to_history(chat_id, order_id, order_type, amount, status):
    if chat_id not in user_history:
        user_history[chat_id] = []
    user_history[chat_id] = [op for op in user_history[chat_id] if f"ID #{order_id}" not in op]
    emoji_status = "🟢" if status == "accepted" else "🔵" if status == "refunded" else "🔴"
    user_history[chat_id].append(f"🆔 **ID #{order_id}**\n📌 `{order_type}`\n💰 `{amount:,.1f}`\n📊 {emoji_status} `{status}`\n---")

